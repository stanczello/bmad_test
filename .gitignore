# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Build outputs ────────────────────────────────────────────────────────────
# Electron + Vite client
emotional-aquarium-client/dist/
emotional-aquarium-client/out/
emotional-aquarium-client/build/

# TypeScript / Fastify server
emotional-aquarium-server/dist/

# ─── Test / coverage artefacts ────────────────────────────────────────────────
emotional-aquarium-client/coverage/
emotional-aquarium-server/coverage/
emotional-aquarium-server/test-results/
emotional-aquarium-server/playwright-report/
playwright-report/

# ─── Environment files (contain secrets) ─────────────────────────────────────
.env
.env.local
.env.*.local
emotional-aquarium-server/.env
emotional-aquarium-client/.env
# Keep the example / template files committed so new contributors can copy them
!.env.compose.example
!emotional-aquarium-server/.env.example
!emotional-aquarium-client/.env.example

# ─── Runtime / SQLite database ────────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db

# ─── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln

# ─── Caches ───────────────────────────────────────────────────────────────────
.eslintcache
emotional-aquarium-client/.eslintcache
*.tsbuildinfo

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Electron packaged output ─────────────────────────────────────────────────
emotional-aquarium-client/dist/
release/
